        <mxCell id="WDNej8NxmDWKMDE5rAKB-15" parent="1" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=center;rounded=1;strokeColor=#b85450;strokeWidth=3;fontFamily=zain;fontSize=11;fontStyle=1;labelBackgroundColor=none;fillColor=#f8cecc;textDirection=rtl;" value="به دلیل زمان کم پیاده‌سازی و نداشتن مجوزهای لازم، سیستم فعلی فاقد توانایی ارسال پیامک و ارتباط با سامانه‌های بانکی است" vertex="1">
