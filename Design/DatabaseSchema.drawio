        <mxCell id="B-zei__ZKEaII6CAh_98-97" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=25;" value="&lt;font&gt;0..*&lt;/font&gt;" vertex="1">
